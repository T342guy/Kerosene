//! @NAME@.
//!
//! The whole binary: the game, handed to the engine. `cargo play` builds the
//! content and runs this; `@PACKAGE@ --headless 600` is a dedicated server.

mod game;

// Counts allocations, for the `mem` console command. Delete these two lines
// to use the system allocator without counting.
#[global_allocator]
static ALLOCATOR: kerosene::lifecycle::TrackingAllocator = kerosene::lifecycle::TrackingAllocator::new();

fn main() -> kerosene::anyhow::Result<()> {
    kerosene::launch(
        game::@TYPE@::default(),
        kerosene::LaunchOptions::new("@NAME@", env!("CARGO_PKG_VERSION")),
    )
}
