{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Address + leak sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "KEROSENE_BUILD_RENDER": "OFF"
      },
      "description": "Sanitizes the compilers and the simulation, where the pointer and float bugs live. The renderer is left out because building SDL from source under a sanitizer costs minutes for little return -- add -DKEROSENE_BUILD_RENDER=ON when the renderer is what you are chasing."
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "Undefined-behaviour sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
        "KEROSENE_BUILD_RENDER": "OFF"
      },
      "description": "Sanitizes the compilers and the simulation, where the pointer and float bugs live. The renderer is left out because building SDL from source under a sanitizer costs minutes for little return -- add -DKEROSENE_BUILD_RENDER=ON when the renderer is what you are chasing."
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Thread sanitizer",
      "description": "For the job system and anything that shares state across it. The scheduler is the one piece whose bugs are invisible in a passing test run.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "KEROSENE_BUILD_RENDER": "OFF"
      },
      "generator": "Ninja"
    },
    {
      "name": "nogfx",
      "displayName": "Headless: compilers and engine core, no SDL",
      "description": "Everything but the renderer and the runtime. Needs no graphics headers, so it builds outside the toolbox and on a CI machine with no GPU.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/nogfx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KEROSENE_BUILD_RENDER": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "nogfx",
      "configurePreset": "nogfx"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "nogfx",
      "configurePreset": "nogfx",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
