/* The stock HUD's look. Sizes are in UI pixels: a 1080-tall reference
   screen, scaled to the real one. */

@keyframes pulse {
    from { opacity: 1; }
    to { opacity: 0.45; }
}

@keyframes toast {
    0% { opacity: 0; transform: translateY(12px); }
    12% { opacity: 1; transform: translateY(0px); }
    80% { opacity: 1; }
    100% { opacity: 0; }
}

.root {
    color: #f2ede4;
    font-size: 22px;
    text-shadow: 0px 2px rgba(0, 0, 0, 0.75);
}

.caption {
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(242, 237, 228, 0.65);
}

.big {
    font-size: 64px;
    font-weight: bold;
    line-height: 1;
}

.low {
    color: #ff5a3c;
    animation: pulse 0.5s ease-in-out infinite alternate;
}

.corner {
    position: absolute;
    bottom: 48px;
    padding: 16px 24px;
    border-radius: 8px;
    background: linear-gradient(to bottom, rgba(10, 12, 16, 0.25), rgba(10, 12, 16, 0.6));
}

/* ---- crosshair --------------------------------------------------------- */

#crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    margin-top: -32px;
    transition: transform 0.08s ease-out, opacity 0.2s linear;
}
#crosshair Panel {
    position: absolute;
    background-color: #ffffff;
    box-shadow: 0px 0px 3px rgba(0, 0, 0, 0.6);
}
.xh-dot { left: 30px; top: 30px; width: 4px; height: 4px; border-radius: 50%; }
.xh-ring {
    left: 12px; top: 12px; width: 40px; height: 40px;
    border-radius: 50%;
    border: 2px white;
    visibility: hidden;
}
#crosshair .xh-ring { background-color: transparent; box-shadow: none; }
.xh-line { width: 2px; height: 10px; }
.xh-up { left: 31px; top: 12px; }
.xh-down { left: 31px; top: 42px; }
.xh-left { left: 12px; top: 31px; width: 10px; height: 2px; }
.xh-right { left: 42px; top: 31px; width: 10px; height: 2px; }

/* Shotgun: a ring the size of the spread, and nothing else. */
.xh-shotgun .xh-ring { visibility: visible; }
.xh-shotgun .xh-line { visibility: hidden; }

/* Rifle: four lines, wider apart, and no dot. */
.xh-rifle .xh-dot { visibility: hidden; }
.xh-rifle .xh-up { top: 6px; }
.xh-rifle .xh-down { top: 48px; }
.xh-rifle .xh-left { left: 6px; }
.xh-rifle .xh-right { left: 48px; }

#crosshair.firing { transform: scale(1.35); }
#crosshair.reloading { opacity: 0.3; }

/* ---- objective --------------------------------------------------------- */

#objective {
    position: absolute;
    top: 40px;
    left: 48px;
    max-width: 560px;
    padding: 12px 18px;
    border: 1px rgba(255, 168, 48, 0.6);
    border-radius: 4px;
    background-color: rgba(10, 12, 16, 0.45);
}
#objective-text { font-size: 24px; }

/* ---- health ------------------------------------------------------------ */

#vitals { left: 48px; min-width: 220px; }
#health-bar { margin-top: 8px; height: 6px; border-radius: 3px; }
#health-bar .progress-fill { background-color: #7fd46b; border-radius: 3px; transition: width 0.25s ease-out; }
#health-bar.low .progress-fill { background-color: #ff5a3c; }

/* ---- ability ----------------------------------------------------------- */

#ability {
    position: absolute;
    left: 300px;
    bottom: 56px;
    width: 88px;
    height: 88px;
    justify-content: center;
    align-items: center;
}
.ability-ring, .ability-charge {
    position: absolute;
    left: 0px; top: 0px; width: 88px; height: 88px;
    border-radius: 50%;
}
.ability-ring { background-color: rgba(10, 12, 16, 0.55); border: 3px rgba(255, 255, 255, 0.15); }
.ability-charge { background-color: rgba(255, 168, 48, 0.55); }
#ability.ready .ability-charge { background-color: rgba(255, 168, 48, 0.9); box-shadow: 0px 0px 12px rgba(255, 168, 48, 0.6); }
.ability-name { font-size: 15px; letter-spacing: 1px; text-transform: uppercase; }
.ability-time { font-size: 20px; font-weight: bold; }

/* ---- weapons ----------------------------------------------------------- */

#arms { right: 48px; min-width: 260px; align-items: flex-end; }
#slots { flex-direction: row; gap: 6px; margin-bottom: 10px; }
.slot {
    flex-direction: row;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.06);
    opacity: 0.55;
    transition: opacity 0.15s linear, background-color 0.15s linear;
}
.slot.active { opacity: 1; background-color: rgba(255, 168, 48, 0.3); }
.slot-key { font-size: 14px; color: #ffa830; }
.slot-name { font-size: 14px; text-transform: uppercase; }
.ammo-row { flex-direction: row; align-items: flex-end; gap: 10px; }
.ammo-row.empty #clip { color: #ff5a3c; }
#reserve { font-size: 28px; margin-bottom: 8px; color: rgba(242, 237, 228, 0.7); }
#reload-bar { width: 220px; height: 4px; margin-top: 8px; }
#reload-bar .progress-fill { background-color: #ffa830; }

/* ---- toasts ------------------------------------------------------------ */

#toast {
    position: absolute;
    bottom: 220px;
    left: 0px;
    right: 0px;
    text-align: center;
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #ffa830;
    opacity: 0;
}
#toast.show { animation: toast 1.6s linear; }

/* ---- achievement --------------------------------------------------------- */

@keyframes achievement {
    0% { opacity: 0; transform: translateX(40px); }
    8% { opacity: 1; transform: translateX(0px); }
    85% { opacity: 1; }
    100% { opacity: 0; }
}

#achievement {
    position: absolute;
    top: 48px;
    right: 48px;
    flex-direction: column;
    padding: 14px 22px;
    border-radius: 6px;
    border: 2px solid rgba(255, 168, 48, 0.9);
    background-color: rgba(12, 14, 18, 0.82);
    opacity: 0;
}
#achievement.show { animation: achievement 4s linear; }
#achievement-name { font-size: 24px; font-weight: bold; }
