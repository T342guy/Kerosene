<!--
    A status screen, for a non-interactive point_worldpanel: live values
    from the same store the HUD reads, on a wall.
-->
<root reference-height="360">
    <style>
        #screen {
            width: 100%;
            height: 100%;
            padding: 22px 30px;
            gap: 8px;
            background: linear-gradient(to bottom, #0c1a24, #050a0e);
            color: #9fe3ff;
            font-size: 26px;
        }
        .head { font-size: 22px; letter-spacing: 4px; color: #ffa830; margin-bottom: 8px; }
        .row { flex-direction: row; justify-content: space-between; }
        .v { color: #ffffff; text-transform: uppercase; }
        ProgressBar { margin-top: auto; height: 10px; border-radius: 5px; }
        .progress-fill { background-color: #9fe3ff; border-radius: 5px; transition: width 0.2s linear; }
    </style>

    <Panel id="screen">
        <Label class="head" text="KEROSENE // STATUS"/>
        <Panel class="row"><Label text="Map"/><Label class="v" text="{map.name}"/></Panel>
        <Panel class="row"><Label text="Speed"/><Label class="v" text="{player.speed} u/s"/></Panel>
        <Panel class="row"><Label text="Weapon"/><Label class="v" text="{weapon.active}"/></Panel>
        <Panel class="row"><Label text="Shutter code"/><Label class="v" text="1234"/></Panel>
        <ProgressBar value="{player.speed / 400.0}"/>
    </Panel>
</root>
