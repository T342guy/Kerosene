<!--
    The pause menu: what Escape opens over a running map. `interactive` makes
    it modal -- while it is up the mouse is free and every key and click is
    the menu's -- and z keeps it above the HUD and the overlays.

    The pages are one layout, switched by `ui.page`. The options and the list
    of saves are included from files of their own, which the main menu
    includes too.
-->
<root interactive="true" z="100">
    <styles>
        <include src="ui/menus/menu.kcss"/>
    </styles>
    <scripts>
        <include src="ui/menus/pause.kscr"/>
    </scripts>

    <Panel id="backdrop">
        <Panel id="menu">
            <Panel id="brand">
                <Image id="logo" src="ui/logo"/>
                <Panel>
                    <Label class="title" text="{game.title}"/>
                    <Label class="subtitle" text="Paused - {map.name}"/>
                </Panel>
            </Panel>

            <Panel id="main-page" class="page" visible="{ui.page == 'main'}">
                <Button id="resume" text="Resume" onactivate="resume()" sound="ui/click"/>
                <Button text="Save game" onactivate="set_store('ui.page', 'save')" sound="ui/click"/>
                <Button text="Load game" onactivate="set_store('ui.page', 'load')" sound="ui/click"/>
                <Button text="Options" onactivate="set_store('ui.page', 'options')" sound="ui/click"/>
                <Button text="Restart map" onactivate="restart()" sound="ui/click"/>
                <Button text="Quit to menu" onactivate="command('disconnect')" sound="ui/click"/>
                <Button class="danger" text="Quit" onactivate="command('quit')"/>
            </Panel>

            <Panel id="save-page" class="page" visible="{ui.page == 'save'}">
                <Button text="New save" onactivate="new_save()" sound="ui/click"/>
                <Label class="hint" text="Or save over one of these:"/>
                <Include src="ui/menus/saves.kui"/>
                <Button text="Back" onactivate="set_store('ui.page', 'main')" sound="ui/click"/>
            </Panel>

            <Panel id="load-page" class="page" visible="{ui.page == 'load'}">
                <Include src="ui/menus/saves.kui"/>
                <Button text="Back" onactivate="set_store('ui.page', 'main')" sound="ui/click"/>
            </Panel>

            <Panel id="options-page" class="page" visible="{ui.page == 'options'}">
                <Include src="ui/menus/options.kui"/>
                <Button text="Back" onactivate="set_store('ui.page', 'main')" sound="ui/click"/>
            </Panel>
        </Panel>
    </Panel>
</root>
