<!--
    The options page's settings, shared by the main menu and the pause menu:
    each includes this where its options page goes, so the two cannot drift.

    Every control writes a convar directly: `cvar="volume"` on a slider both
    shows the convar and sets it, through the console, so it is saved to
    config.cfg like one typed there.
-->
<root>
    <Panel class="setting">
        <Label class="name" text="Volume"/>
        <Slider cvar="volume" min="0" max="1" step="0.05"/>
        <Label class="value" text="{(cvar.volume * 100.0).round()}%"/>
    </Panel>
    <Panel class="setting">
        <Label class="name" text="Field of view"/>
        <Slider cvar="cl_fov" min="70" max="120" step="1"/>
        <Label class="value" text="{cvar.cl_fov}"/>
    </Panel>
    <Panel class="setting">
        <Label class="name" text="Sensitivity"/>
        <Slider cvar="sensitivity" min="0.5" max="10" step="0.1"/>
        <Label class="value" text="{cvar.sensitivity}"/>
    </Panel>
    <Panel class="setting">
        <Label class="name" text="Brightness"/>
        <Slider cvar="mat_gamma" min="0.5" max="2" step="0.05"/>
        <Label class="value" text="{(cvar.mat_gamma * 100.0).round()}%"/>
    </Panel>
    <Panel class="setting">
        <Toggle cvar="m_invert" text="Invert mouse"/>
    </Panel>
    <Panel class="setting">
        <Toggle cvar="r_vsync" text="Vertical sync"/>
    </Panel>
    <Panel class="setting">
        <Toggle cvar="r_fullscreen" text="Fullscreen"/>
    </Panel>
    <Panel class="setting">
        <Toggle cvar="ui_debug" text="Outline UI panels"/>
    </Panel>
</root>
