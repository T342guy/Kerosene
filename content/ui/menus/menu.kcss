/* Menus: the pause menu, and a starting point for any other. */

#backdrop {
    position: absolute;
    left: 0px; top: 0px; right: 0px; bottom: 0px;
    background: linear-gradient(to right, rgba(6, 8, 12, 0.92), rgba(6, 8, 12, 0.35));
    justify-content: center;
    padding-left: 120px;
}

#menu {
    width: 520px;
    gap: 28px;
    animation: slide-in 0.25s ease-out;
}

@keyframes slide-in {
    from { opacity: 0; transform: translateX(-40px); }
    to { opacity: 1; transform: translateX(0px); }
}

#brand { flex-direction: row; align-items: center; gap: 20px; }
#logo { width: 72px; height: 72px; }
.title { font-size: 56px; font-weight: bold; letter-spacing: 4px; text-transform: uppercase; }
.subtitle { font-size: 18px; color: rgba(242, 237, 228, 0.6); }

.page { gap: 10px; }

.page Button {
    justify-content: flex-start;
    padding: 14px 22px;
    font-size: 26px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
}
.page Button:hover, .page Button:focus {
    background-color: rgba(255, 168, 48, 0.25);
    transform: translateX(8px);
}
.page Button.danger:hover, .page Button.danger:focus {
    background-color: rgba(255, 70, 50, 0.35);
}

.setting {
    flex-direction: row;
    align-items: center;
    gap: 18px;
    padding: 8px 0px;
}
.setting .name { width: 180px; color: rgba(242, 237, 228, 0.8); }
.setting .value { width: 60px; text-align: right; color: #ffa830; }
.setting Slider { flex-grow: 1; }

/* The main menu stands on its own, with nothing behind it to see through. */
#backdrop.title-screen {
    background: linear-gradient(to right, rgba(6, 8, 12, 1.0), rgba(22, 18, 14, 1.0));
}

.error {
    padding: 12px 18px;
    border-radius: 6px;
    background-color: rgba(255, 70, 50, 0.25);
    color: #ffd2c8;
    font-size: 18px;
}

.hint, .empty { color: rgba(242, 237, 228, 0.6); font-size: 18px; }

.save-list { gap: 8px; }
.page Button.save { flex-direction: column; align-items: flex-start; gap: 2px; padding: 10px 22px; }
.save-name { font-size: 24px; }
.save-detail { font-size: 16px; color: rgba(242, 237, 228, 0.6); }

/* The loading screen. */
#loading {
    position: absolute;
    left: 0px; top: 0px; right: 0px; bottom: 0px;
    background-color: #06080c;
    justify-content: center;
    align-items: center;
    gap: 24px;
}
#loading-logo { width: 96px; height: 96px; }
.loading-text { font-size: 28px; letter-spacing: 2px; color: rgba(242, 237, 228, 0.85); }

/* The splash. The whole screen is one button, so any click skips it. */
#splash {
    position: absolute;
    left: 0px; top: 0px; right: 0px; bottom: 0px;
    background-color: #06080c;
    justify-content: center;
    align-items: center;
    gap: 20px;
    animation: fade-in 0.4s ease-out;
}
@keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
}
#splash-logo { width: 128px; height: 128px; }
.splash-text { font-size: 22px; letter-spacing: 6px; text-transform: uppercase; color: rgba(242, 237, 228, 0.7); }
