// The pause menu's behaviour. Functions here are what the buttons'
// `onactivate` attributes call.

fn on_load() {
    set_store("ui.page", "main");
}

fn resume() {
    set_store("ui.page", "main");
    // Hiding the menu layer is all it takes: the host sees no layer wants
    // the mouse any more and hands it back to the game.
    hide_layer("menu");
}

fn restart() {
    command("restart");
    resume();
}

// A save picked from the list: overwritten on the save page, loaded on the
// load page.
fn pick_save(name) {
    if store("ui.page") == "save" {
        command("save " + name);
        resume();
    } else {
        command("load " + name);
        resume();
    }
}

// A save of its own, named after the map and numbered past the last.
fn new_save() {
    let count = store("saves.count");
    if count == () { count = 0; }
    command("save " + store("map.name") + "_" + (count + 1));
    resume();
}
