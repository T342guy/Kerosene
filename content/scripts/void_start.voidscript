// The sample map's script.
//
// Loaded automatically because it is named after the map: the engine looks
// for scripts/<map>.voidscript when a level loads, runs its top level, and
// then calls on_map_start if it is defined.
//
// This exists to be read as much as to be run. Everything a script can do is
// in `docs/scripting.md`; what is here is the shape of a real one.

// Top-level code runs at load, before any entity has ticked.
let visits = 0;
let greeted = false;

fn on_map_start() {
    print(`void_start loaded with ${entity_count()} entities`);

    // Wiring done in code rather than in the editor. Useful for things a
    // designer would otherwise have to repeat on every one of a group.
    for light in find_by_class("light_environment") {
        print(`sun: ${light.get("_light")}`);
    }
}

// Called every tick, if it is defined at all. Left cheap on purpose: this
// runs 64 times a second.
fn on_tick(dt) {
    if greeted { return; }
    if time() > 2.0 {
        greeted = true;
        print("two seconds in");
    }
}

// Called by a logic_script entity's CallScriptFunction input. The parameter
// is the name of whatever fired it, so one function can serve several
// callers -- or it can take none at all, and both spellings work.
fn on_used(who) {
    visits += 1;
    print(`used by ${who}, ${visits} time(s)`);
    if visits >= 3 {
        ent_fire("gate", "Open", "", 0.5);
    }
}
