# A plain 0.8 m cube, authored Y-up in metres, centred on its origin so the
# physics body sits where the model draws. Compiles to a ~32-inch cube.
o cube

v -0.4 -0.4 -0.4
v  0.4 -0.4 -0.4
v  0.4 -0.4  0.4
v -0.4 -0.4  0.4
v -0.4  0.4 -0.4
v  0.4  0.4 -0.4
v  0.4  0.4  0.4
v -0.4  0.4  0.4

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0  0 -1
vn  1  0  0
vn  0  0  1
vn -1  0  0
vn  0  1  0
vn  0 -1  0

usemtl dev/orange
f 5/4/1 6/3/1 2/2/1 1/1/1
f 6/4/2 7/3/2 3/2/2 2/1/2
f 7/4/3 8/3/3 4/2/3 3/1/3
f 8/4/4 5/3/4 1/2/4 4/1/4
f 8/4/5 7/3/5 6/2/5 5/1/5
f 1/4/6 2/3/6 3/2/6 4/1/6
