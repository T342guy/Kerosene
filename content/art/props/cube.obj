# A plain 0.8 m cube, authored Y-up in metres, centred on its origin so the
# physics body sits where the model draws. Compiles to a ~32-inch cube.
o cube

v -0.4 -0.4 -0.4
v  0.4 -0.4 -0.4
v  0.4 -0.4  0.4
v -0.4 -0.4  0.4
v -0.4  0.4 -0.4
v  0.4  0.4 -0.4
v  0.4  0.4  0.4
v -0.4  0.4  0.4

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0  0 -1
vn  1  0  0
vn  0  0  1
vn -1  0  0
vn  0  1  0
vn  0 -1  0

usemtl dev/orange
f 1/1/1 2/2/1 6/3/1 5/4/1
f 2/1/2 3/2/2 7/3/2 6/4/2
f 3/1/3 4/2/3 8/3/3 7/4/3
f 4/1/4 1/2/4 5/3/4 8/4/4
f 5/1/5 6/2/5 7/3/5 8/4/5
f 4/1/6 3/2/6 2/3/6 1/4/6
